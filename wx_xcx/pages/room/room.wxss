/* pages/room/room.wxss */
page {
  height: 100%;
  background: #f2f3f7;
}

.container {
  min-height: 100vh;
  padding-bottom: 220rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #667eea 0%, #7a6fca 260rpx, #f2f3f7 560rpx, #f2f3f7 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部房间信息 */
.room-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx 52rpx;
  color: #fff;
}

.room-label {
  font-size: 24rpx;
  opacity: 0.82;
  letter-spacing: 2rpx;
}

.room-header-left {
  display: flex;
  flex-direction: column;
}

.room-id-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.room-id {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  line-height: 1.1;
}

.copy-btn {
  margin-left: 20rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.room-header-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 128rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
}

.room-count {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}

.room-count-label {
  margin-top: 2rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

/* 玩家区 */
.players-section {
  padding: 0 24rpx;
  margin-top: -32rpx;
}

.players-scroll {
  display: flex;
  white-space: nowrap;
  padding: 8rpx 0 16rpx;
  width: 100%;
  /* 横向 scroll-view 必须给固定高度，否则首次渲染高度塌陷会把卡片裁掉 */
  height: 320rpx;
  box-sizing: border-box;
}

.players-scroll .player-card {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 280rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 24rpx 0 20rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(54, 60, 110, 0.12);
}

.player-card-hover {
  transform: scale(0.96);
  opacity: 0.94;
}

.player-card.owner {
  background: linear-gradient(180deg, #fffaf0 0%, #ffffff 62%);
  box-shadow: 0 10rpx 26rpx rgba(255, 176, 32, 0.24);
}

.owner-tag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: #8a5a00;
  background: linear-gradient(135deg, #ffe08a, #ffc53d);
  border-radius: 0 28rpx 0 18rpx;
  line-height: 1.7;
}

/* 圆形头像：固定宽高 + 圆形裁切，避免 flex 拉伸变形 */
.avatar-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  background: #f4f5fa;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #e8e9f3, 0 6rpx 14rpx rgba(54, 60, 110, 0.12);
}

.player-card.owner .avatar-ring {
  box-shadow: 0 0 0 3rpx #ffc53d, 0 6rpx 14rpx rgba(255, 176, 32, 0.25);
}

.player-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.player-avatar-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.player-name {
  max-width: 152rpx;
  margin-bottom: 6rpx;
  font-size: 26rpx;
  color: #4a4f68;
  text-align: center;
}

.text-ellipsis {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.player-score {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b35;
  line-height: 1.2;
}

.player-score.negative {
  color: #ff4d4f;
}

/* 提示 */
.tips {
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx 0;
}

.tips text {
  color: #9aa0b5;
  font-size: 24rpx;
}

.tips-icon {
  margin-right: 8rpx;
}

/* 得分记录 */
.history-section {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 28rpx 12rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(54, 60, 110, 0.08);
}

.history-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2f3651;
}

.history-count {
  font-size: 22rpx;
  color: #9aa0b5;
}

.history-list {
  max-height: 440rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f2f7;
}

.history-item:last-child {
  border-bottom: none;
}

.history-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #ff8a4c;
  flex-shrink: 0;
}

.history-text {
  flex: 1;
  font-size: 26rpx;
  color: #3c425c;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.history-time {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #a6abbf;
}

.empty-history {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 46rpx 0 58rpx;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #a6abbf;
}

/* 底部退出 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #eceef5;
}

.exit-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #fff5f0;
  color: #ff6b35;
  font-size: 28rpx;
  font-weight: 600;
}

.exit-btn-hover {
  background: #ffe8dd;
}

.exit-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

/* 计分弹窗 */
.score-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 26, 43, 0.55);
  z-index: 100;
}

.score-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 48rpx;
  padding: 40rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 -8rpx 40rpx rgba(23, 26, 43, 0.18);
  z-index: 101;
  box-sizing: border-box;
}

.score-modal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2f3651;
}

.modal-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9aa0b5;
}

.score-modal-body {
  margin-bottom: 32rpx;
}

.score-input {
  width: 100%;
  height: 110rpx;
  background: #f5f6fa;
  border-radius: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  color: #2f3651;
}

.score-modal-footer {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #f2f3f7;
  color: #6a7085;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #ff8a4c, #ff6b35);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.3);
}
