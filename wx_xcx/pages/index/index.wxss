/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

/* 用户信息样式 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.user-avatar-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.user-avatar-btn::after {
  border: none;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 4rpx solid #ccc;
}

.user-name-input {
  margin-top: 24rpx;
  font-size: 36rpx;
  color: white;
  font-weight: bold;
  text-align: center;
  background: transparent;
  border: none;
  padding: 12rpx 24rpx;
}

.user-name-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

/* 按钮区域 */
.content {
  flex: 1;
}

.button-row {
  display: flex;
  gap: 20rpx;
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.btn {
  flex: 1;
  height: 100rpx;
  background: white;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #667eea;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  min-width: 260rpx;
}

/* 输入房号进房 */
.join-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.room-id-input {
  flex: 1;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.room-id-input::placeholder {
  color: #999;
  font-size: 28rpx;
}

.join-btn {
  flex: 0 0 200rpx;
  min-width: 0;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
}